# tutor/
PINECONE_API_KEY=
PINECONE_INDEX=

# ── Groq API Keys ─────────────────────────────────────────────────────────────
# Key 1: Primary response generation for PRAG-TUTOR service
GROQ_API_KEY=

# Key 2: Fallback key for response generation (used automatically if Key 1 hits rate limits)
GROQ_FALLBACK_API_KEY=

# Key 3: Dedicated key for LLM-as-a-Judge evaluation (prevents evaluation starvation)
GROQ_JUDGE_API_KEY=

# optional
OLLAMA_URL=
OLLAMA_MODEL=

# backend/
MONGODB_URI=
DB_NAME=

# AUTH_SECRET is REQUIRED in production. Generate a secure random secret (min 32 chars)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
